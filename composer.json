{
	"name": "seoulcommerce/woocommerce-tosspayments",
	"description": "SeoulCommerce TossPayments payment gateway for WooCommerce",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "seoulcommerce",
			"email": "info@seoulcommerce.com"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.0",
		"phpcompatibility/phpcompatibility-wp": "*",
		"woocommerce/woocommerce-sniffs": "^2.0",
		"phpunit/phpunit": "^9.6",
		"mockery/mockery": "^1.5"
	},
	"autoload-dev": {
		"psr-4": {
			"SeoulCommerce\\TossPayments\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"test": "phpunit"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
